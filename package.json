{
  "name": "voxa",
  "version": "0.1.0",
  "description": "System-wide voice-to-text desktop helper using ChatGPT transcription",
  "homepage": "https://github.com/blackscythe123/voxa",
  "main": "src/main.js",
  "author": {
    "name": "Voxa",
    "email": "noreply@voxa.app"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "icons": "node scripts/make-icon.js",
    "prebuild": "node scripts/make-icon.js",
    "build": "electron-builder",
    "build:win": "node scripts/make-icon.js && electron-builder --win",
    "build:mac": "node scripts/make-icon.js && electron-builder --mac",
    "build:linux": "node scripts/make-icon.js && electron-builder --linux",
    "build:all": "node scripts/make-icon.js && electron-builder -mwl"
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^42.0.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.Voxa.app",
    "productName": "Voxa",
    "copyright": "Copyright © 2026 Voxa",
    "directories": {
      "buildResources": "assets",
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "!**/.DS_Store",
      "!**/*.map"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "executableName": "Voxa",
      "artifactName": "Voxa-${version}-${arch}.${ext}",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voxa",
      "menuCategory": false,
      "uninstallDisplayName": "Voxa — voice to text",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Voxa needs microphone access to record your voice for transcription.",
        "NSAppleEventsUsageDescription": "Voxa pastes your transcript into the focused app by sending a Cmd+V keystroke.",
        "NSSystemAdministrationUsageDescription": "Voxa pastes transcripts into other apps via the keyboard, which macOS treats as an Accessibility action.",
        "LSUIElement": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Voxa ${version}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Utility;AudioVideo;Audio",
      "synopsis": "System-wide voice-to-text powered by ChatGPT Whisper",
      "description": "Voxa records your voice on a global hotkey, transcribes it through ChatGPT, and pastes the result into whatever app is focused.",
      "maintainer": "Voxa <noreply@voxa.app>",
      "executableName": "voxa",
      "desktop": {
        "entry": {
          "Name": "Voxa",
          "GenericName": "Voice to Text",
          "Comment": "Push-to-talk transcription via ChatGPT",
          "Keywords": "voice;dictation;speech;transcribe;whisper;chatgpt;microphone;",
          "StartupWMClass": "Voxa",
          "Categories": "Utility;AudioVideo;Audio;",
          "Terminal": "false",
          "Type": "Application"
        }
      }
    },
    "deb": {
      "depends": [
        "libasound2 | libasound2t64",
        "libgtk-3-0 | libgtk-3-0t64",
        "libnss3",
        "libxss1",
        "libsecret-1-0",
        "xdotool"
      ]
    }
  }
}
